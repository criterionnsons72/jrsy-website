# ---- Tailor Master API env (copy to apps/api/.env) ----

# App
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database (matches docker-compose Postgres)
DATABASE_URL=postgresql://tailor:tailor_dev_password@localhost:5432/tailor_master?schema=public

# Redis (cache + queues)
REDIS_URL=redis://localhost:6379

# Auth — CHANGE these; generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=1209600     # seconds (14d)

# Object storage (MinIO in dev / S3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tailor-assets
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password

# Integration adapters (mock first — see docs/stage-5)
TRYON_PROVIDER=mock
BODYSCAN_PROVIDER=mock
PAYMENT_PROVIDER=mock
