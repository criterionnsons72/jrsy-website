# ----------------------------------------------------------------------
# Mufti Sahab — environment variables
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
# The .env file is git-ignored and must NEVER be committed.
# ----------------------------------------------------------------------

# Your Groq API key (get one at https://console.groq.com/keys)
# Read ONLY on the server. Never exposed to the browser.
GROQ_API_KEY=your_groq_api_key_here

# Optional: which Groq model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: port the local server listens on (default: 3000)
PORT=3000
