# ---- Root / shared dev env (copy to .env) ----
# These mirror the docker-compose services for local development.

# PostgreSQL
POSTGRES_USER=tailor
POSTGRES_PASSWORD=tailor_dev_password   # CHANGE for anything non-local
POSTGRES_DB=tailor_master
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_password   # CHANGE for anything non-local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
